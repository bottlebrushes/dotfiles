#!/usr/bin/env sh

#
# for this to work you must configure sudo such that
# it will be able to run the command without password
#
# see this wiki page for information:
#  - https://github.com/koekeishiya/yabai/wiki/Installing-yabai-(latest-release)#configure-scripting-addition
#
# yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
# sudo yabai --load-sa
#

# global settings
yabai -m config                                 \
    external_bar                 all:32:0       \
    menubar_opacity              1.0            \
    mouse_follows_focus          off            \
    focus_follows_mouse          off            \
    display_arrangement_order    default        \
    window_origin_display        default        \
    window_placement             second_child   \
    window_insertion_point       focused        \
    window_zoom_persist          on             \
    window_shadow                on             \
    window_animation_duration    0.0            \
    window_animation_easing      ease_out_circ  \
    window_opacity_duration      0.0            \
    active_window_opacity        1.0            \
    normal_window_opacity        0.90           \
    window_opacity               off            \
    insert_feedback_color        0xffd75f5f     \
    split_ratio                  0.50           \
    split_type                   auto           \
    auto_balance                 off            \
    top_padding                  18             \
    bottom_padding               6              \
    left_padding                 12             \
    right_padding                12             \
    window_gap                   06             \
    layout                       bsp            \
    mouse_modifier               fn             \
    mouse_action1                move           \
    mouse_action2                resize         \
    mouse_drop_action            swap

# App rules - always float
yabai -m rule --add app="^Messages$" manage=off
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Finder$" title="(Copy|Bin|Info|Connect)" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add app="^Disk Utility$" manage=off
yabai -m rule --add app="^Installer$" manage=off
yabai -m rule --add app="^Keychain Access$" manage=off
yabai -m rule --add app="^App Store$" manage=off
yabai -m rule --add app="^Font Book$" manage=off
yabai -m rule --add app="^Calendar$" manage=off
yabai -m rule --add app="^FaceTime$" manage=off
yabai -m rule --add app="^Photo Booth$" manage=off
yabai -m rule --add app="^Stickies$" manage=off
yabai -m rule --add app="^System Information$" manage=off
yabai -m rule --add app="^Software Update$" manage=off
yabai -m rule --add app="^Claude$" manage=off

# Assign apps to spaces
yabai -m rule --add app="^Slack$" space=2
yabai -m rule --add app="^Spark Desktop$" space=3
yabai -m rule --add app="^Notion Calendar$" space=4
yabai -m rule --add app="^TIDAL$" space=5

# Signal handlers for Barik event-based updates
yabai -m signal --add event=space_changed action="echo \"space_changed:\$YABAI_SPACE_INDEX\" | nc -U /tmp/barik-yabai.sock 2>/dev/null || true"
yabai -m signal --add event=window_focused action="echo \"window_focused:\$YABAI_SPACE_INDEX\" | nc -U /tmp/barik-yabai.sock 2>/dev/null || true"
yabai -m signal --add event=window_created action="echo \"window_created:\$YABAI_SPACE_INDEX\" | nc -U /tmp/barik-yabai.sock 2>/dev/null || true"
yabai -m signal --add event=window_destroyed action="echo \"window_destroyed:\$YABAI_SPACE_INDEX\" | nc -U /tmp/barik-yabai.sock 2>/dev/null || true"
yabai -m signal --add event=window_moved action="echo \"window_moved:\$YABAI_SPACE_INDEX\" | nc -U /tmp/barik-yabai.sock 2>/dev/null || true"
yabai -m signal --add event=space_created action="echo \"space_created:\$YABAI_SPACE_INDEX\" | nc -U /tmp/barik-yabai.sock 2>/dev/null || true"
yabai -m signal --add event=space_destroyed action="echo \"space_destroyed:\$YABAI_SPACE_ID\" | nc -U /tmp/barik-yabai.sock 2>/dev/null || true"

echo "yabai configuration loaded.."
